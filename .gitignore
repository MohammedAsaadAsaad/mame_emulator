# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android Studio
/android/app/debug
/android/app/profile
/android/app/release

# Large native core binaries — fetch with scripts/fetch_cores.sh
native/cores/*.so
native/cores/*.dylib
native/cores/*.dll
native/saves/
native/support/
native/savestates/
*.state

# Android jniLibs cores (large) — fetch with scripts/fetch_android_cores.sh
android/app/src/main/jniLibs/**/*.so

# Keep helper library source / built helper for Linux local runs if present
!native/shim/
!scripts/
native/libhost_helpers.so
native/host_helpers.dll
native/libhost_helpers.dll
native/shim/*.so
native/*.obj
native/*.exp
native/*.lib
native/*.pdb
tool/minhost
tool/*.o


# User-provided ROMs (do not upload copyrighted dumps)
roms/*.zip
roms/*.7z
!roms/README.md

# Personal BIOS dumps (bundle locally under assets/bios/ — do not commit)
assets/bios/*.zip
assets/bios/*.7z
assets/bios/neogeo.zip.*
!assets/bios/README.md

# Local secrets / keystores
*.jks
*.keystore
key.properties
.env
